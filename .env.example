# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=upwork_leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# External Search Provider (Optional: Pre-cached fixtures provided for tests)
SERPAPI_API_KEY=

# Scraper Pacing & Anti-Blocking Jitter (Seconds)
RATE_LIMIT_MIN_JITTER_SECONDS=8.0
RATE_LIMIT_MAX_JITTER_SECONDS=15.0

